<% content_for :title, "Mon compte" %>

<section class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <h1 class="text-2xl font-bold text-slate-900">Compte</h1>
    <p class="mt-2 text-sm text-slate-600">Informations de votre compte SaaS PanierBot.</p>

    <dl class="mt-6 grid gap-4 sm:grid-cols-2">
      <div class="rounded-xl bg-slate-50 p-4">
        <dt class="text-xs uppercase tracking-wide text-slate-500">Email</dt>
        <dd class="mt-1 text-sm font-semibold text-slate-900"><%= current_user.email %></dd>
      </div>
      <div class="rounded-xl bg-slate-50 p-4">
        <dt class="text-xs uppercase tracking-wide text-slate-500">Plan</dt>
        <dd class="mt-1 text-sm font-semibold text-slate-900"><%= current_user.plan.capitalize %></dd>
      </div>
      <div class="rounded-xl bg-slate-50 p-4">
        <dt class="text-xs uppercase tracking-wide text-slate-500">Statut abonnement</dt>
        <dd class="mt-1 text-sm font-semibold text-slate-900"><%= current_user.subscription_status %></dd>
      </div>
      <div class="rounded-xl bg-slate-50 p-4">
        <dt class="text-xs uppercase tracking-wide text-slate-500">Vitesse prioritaire</dt>
        <dd class="mt-1 text-sm font-semibold text-slate-900"><%= current_user.priority_speed? ? "Oui" : "Non" %></dd>
      </div>
    </dl>

    <div class="mt-6 flex flex-wrap gap-3">
      <%= link_to "Gérer l'abonnement", billing_path, class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700" %>
      <%= link_to "Voir l'usage", usage_path, class: "rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
      <%= link_to "Voir les plans", plans_path, class: "rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
    </div>
  </div>
</section>