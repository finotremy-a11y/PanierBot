<% content_for :title, "Mon compte" %>

<section class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
  <div class="rounded-2xl border border-[#c2c9bb] bg-white p-6 shadow-sm">
    <h1 class="text-2xl font-bold text-[#1b1c1c]">Compte</h1>
    <p class="mt-2 text-sm text-[#42493e]">Informations de votre compte SaaS PanierBot.</p>

    <dl class="mt-6 grid gap-4 sm:grid-cols-2">
      <div class="rounded-xl bg-[#f6f3f2] p-4">
        <dt class="text-xs uppercase tracking-wide text-[#72796e]">Email</dt>
        <dd class="mt-1 text-sm font-semibold text-[#1b1c1c]"><%= current_user.email %></dd>
      </div>
      <div class="rounded-xl bg-[#f6f3f2] p-4">
        <dt class="text-xs uppercase tracking-wide text-[#72796e]">Plan</dt>
        <dd class="mt-1 text-sm font-semibold text-[#1b1c1c]"><%= current_user.plan.capitalize %></dd>
      </div>
      <div class="rounded-xl bg-[#f6f3f2] p-4">
        <dt class="text-xs uppercase tracking-wide text-[#72796e]">Statut abonnement</dt>
        <dd class="mt-1 text-sm font-semibold text-[#1b1c1c]"><%= current_user.subscription_status %></dd>
      </div>
      <div class="rounded-xl bg-[#f6f3f2] p-4">
        <dt class="text-xs uppercase tracking-wide text-[#72796e]">Vitesse prioritaire</dt>
        <dd class="mt-1 text-sm font-semibold text-[#1b1c1c]"><%= current_user.priority_speed? ? "Oui" : "Non" %></dd>
      </div>
    </dl>

    <div class="mt-6 flex flex-wrap gap-3">
      <%= link_to "Gérer l'abonnement", billing_path, class: "rounded-lg bg-[#2d5a27] px-4 py-2 text-sm font-semibold text-white hover:bg-[#154212]" %>
      <%= link_to "Voir l'usage", usage_path, class: "rounded-lg border border-[#c2c9bb] bg-white px-4 py-2 text-sm font-semibold text-[#42493e] hover:bg-[#f6f3f2]" %>
      <%= link_to "Voir les plans", plans_path, class: "rounded-lg border border-[#c2c9bb] bg-white px-4 py-2 text-sm font-semibold text-[#42493e] hover:bg-[#f6f3f2]" %>
    </div>
  </div>
</section>