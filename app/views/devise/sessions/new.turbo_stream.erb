<%= turbo_stream.replace "main-content" do %>
  <section class="mx-auto flex w-full max-w-md flex-1 items-center px-4 py-16 sm:px-6">
    <div class="w-full rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
      <h1 class="text-2xl font-bold text-slate-900">Connexion requise</h1>
      <p class="mt-3 text-sm text-slate-600">Cette action a demandé une session Devise pendant une requête Turbo. Ouvrez la page HTML de connexion pour continuer.</p>
      <div class="mt-6">
        <%= link_to "Ouvrir la page de connexion", new_user_session_path(format: :html), data: { turbo_frame: "_top" }, class: "inline-flex items-center rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700" %>
      </div>
    </div>
  </section>
<% end %>