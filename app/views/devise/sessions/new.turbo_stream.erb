<%= turbo_stream.replace "main-content" do %>
  <section class="mx-auto flex w-full max-w-md flex-1 items-center px-4 py-16 sm:px-6">
    <div class="w-full rounded-2xl border border-[#c2c9bb] bg-white p-8 shadow-sm">
      <h1 class="text-2xl font-bold text-[#1b1c1c]">Connexion requise</h1>
      <p class="mt-3 text-sm text-[#42493e]">Cette action a demandé une session Devise pendant une requête Turbo. Ouvrez la page HTML de connexion pour continuer.</p>
      <div class="mt-6">
        <%= link_to "Ouvrir la page de connexion", new_user_session_path(format: :html), data: { turbo_frame: "_top" }, class: "inline-flex items-center rounded-lg bg-[#2d5a27] px-4 py-2 text-sm font-semibold text-white hover:bg-[#154212]" %>
      </div>
    </div>
  </section>
<% end %>