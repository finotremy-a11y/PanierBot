<%# Landing page — hero + comparison form %>
<% content_for :title, "PanierBot — Comparez vos courses en drive" %>

<%# ── Hero ── %>
<section class="relative overflow-hidden bg-gradient-to-br from-indigo-600 via-indigo-700 to-violet-800 pb-32 pt-20 text-white">
  <%# Decorative blobs %>
  <div class="pointer-events-none absolute -top-24 right-0 h-96 w-96 rounded-full bg-white/5 blur-3xl"></div>
  <div class="pointer-events-none absolute bottom-0 left-0 h-64 w-64 rounded-full bg-indigo-500/30 blur-3xl"></div>

  <div class="relative mx-auto max-w-3xl px-4 text-center sm:px-6">
    <span class="mb-4 inline-flex items-center gap-1.5 rounded-full bg-white/15 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-indigo-100 ring-1 ring-white/20">
      ✨ Gratuit · Instantané · Précis
    </span>
    <h1 class="mt-4 text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl lg:text-6xl">
      Trouvez le meilleur prix<br>pour vos courses en drive
    </h1>
    <p class="mt-5 text-lg text-indigo-200 sm:text-xl">
      Comparez Leclerc, Carrefour, Intermarché et Super U en quelques secondes.
      PanierBot analyse les prix pour vous et construit votre panier optimal.
    </p>

    <%# Stats badges %>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <div class="flex items-center gap-2 rounded-xl bg-white/10 px-4 py-2 text-sm font-medium ring-1 ring-white/20">
        🏪 4 enseignes comparées
      </div>
      <div class="flex items-center gap-2 rounded-xl bg-white/10 px-4 py-2 text-sm font-medium ring-1 ring-white/20">
        ⚡ Résultat en temps réel
      </div>
      <div class="flex items-center gap-2 rounded-xl bg-white/10 px-4 py-2 text-sm font-medium ring-1 ring-white/20">
        🛒 Panier optimal calculé
      </div>
    </div>
  </div>
</section>

<%# ── Main form card (overlapping hero) ── %>
<section class="-mt-20 px-4 pb-16 sm:px-6">
  <div class="mx-auto max-w-2xl">
    <div class="rounded-2xl border border-slate-200 bg-white shadow-xl shadow-slate-200/60"
         data-controller="compare mode strategy">

      <div class="p-6 sm:p-8">
        <h2 class="text-xl font-bold text-slate-900">Votre liste de courses</h2>
        <p class="mt-1 text-sm text-slate-500">Un produit par ligne. Ex: pâtes, lait demi-écrémé, bananes.</p>

        <%= form_with url: compare_path, scope: :comparison, method: :post,
            data: { controller: "compare", action: "submit->compare#submit",
                    turbo: true, turbo_frame: "_top" },
            class: "mt-6 space-y-6" do |f| %>

          <%# ── Shopping list input ── %>
          <div data-controller="list">
            <div class="flex items-center justify-between mb-3">
              <label class="text-sm font-medium text-slate-700">Produits</label>
              <button type="button"
                      data-action="click->list#addItem"
                      class="inline-flex items-center gap-1 rounded-lg border border-dashed border-indigo-300 bg-indigo-50 px-3 py-1 text-xs font-semibold text-indigo-600 hover:bg-indigo-100 transition-colors">
                + Ajouter un produit
              </button>
            </div>

            <div id="items-list" class="space-y-2" data-list-target="container">
              <div class="flex items-center gap-2" data-list-target="item">
                  <span data-badge class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-indigo-100 text-xs font-bold text-indigo-600">1</span>
                <input type="text" name="comparison[items_text][]"
                       placeholder="Ex: pâtes 500g"
                       class="min-w-0 flex-1 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 placeholder-slate-400 shadow-sm focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-400/20 transition"
                    data-list-target="input" data-action="input->list#inputChanged" autofocus>
                <button type="button" data-action="click->list#removeItem"
                        class="flex h-7 w-7 items-center justify-center rounded-lg text-slate-400 hover:bg-red-50 hover:text-red-500 transition-colors"
                        aria-label="Supprimer">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                  </svg>
                </button>
              </div>
            </div>

            <%# Hidden mirror used by Stimulus without colliding with submitted params %>
            <input type="hidden" id="items_hidden" data-list-target="hidden">
          </div>

          <%# ── City ── %>
          <div>
            <%= f.label :city, "Ville (pour la sélection du drive)", class: "mb-1.5 block text-sm font-medium text-slate-700" %>
            <%= f.text_field :city, value: "Paris", placeholder: "Paris",
                class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-400/20 transition" %>
          </div>

          <%# ── Mode selector ── %>
          <div data-mode-target="root">
            <p class="mb-3 text-sm font-medium text-slate-700">Mode de comparaison</p>
            <div class="grid grid-cols-2 gap-3">
              <label class="mode-option relative flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 bg-slate-50 p-4 transition hover:border-indigo-300 hover:bg-indigo-50/50 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50 has-[:checked]:ring-1 has-[:checked]:ring-indigo-500">
                <%= f.radio_button :mode, "multi_store", checked: true,
                    class: "mt-0.5 h-4 w-4 text-indigo-600 focus:ring-indigo-500",
                    data: { action: "change->mode#changed" } %>
                <span>
                  <span class="block text-sm font-semibold text-slate-900">Multi-enseignes</span>
                  <span class="mt-0.5 block text-xs text-slate-500">Compare les 4 drives et construit le panier optimal</span>
                </span>
              </label>

              <label class="mode-option relative flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 bg-slate-50 p-4 transition hover:border-indigo-300 hover:bg-indigo-50/50 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50 has-[:checked]:ring-1 has-[:checked]:ring-indigo-500">
                <%= f.radio_button :mode, "single_store",
                    class: "mt-0.5 h-4 w-4 text-indigo-600 focus:ring-indigo-500",
                    data: { action: "change->mode#changed" } %>
                <span>
                  <span class="block text-sm font-semibold text-slate-900">Mono-enseigne</span>
                  <span class="mt-0.5 block text-xs text-slate-500">Construit le panier dans une seule enseigne</span>
                </span>
              </label>
            </div>

            <%# Store selector (shown only in single_store mode) %>
            <div id="store-selector" class="mt-3 hidden" data-mode-target="storeSelector">
              <%= f.label :store, "Choisir l'enseigne", class: "mb-1.5 block text-sm font-medium text-slate-700" %>
              <%= f.select :store,
                  [["Leclerc Drive", "leclerc"], ["Carrefour Drive", "carrefour"],
                   ["Intermarché Drive", "intermarche"], ["Super U Drive", "superu"]],
                  {},
                  class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-400/20 transition" %>
            </div>
          </div>

          <%# ── Strategy selector ── %>
          <div>
            <p class="mb-3 text-sm font-medium text-slate-700">Stratégie de sélection</p>
            <div class="grid grid-cols-2 gap-2 sm:grid-cols-4" data-strategy-target="root">
              <% [
                { value: "cheapest",    label: "Moins cher",     icon: "💰", desc: "Prix total" },
                { value: "best_per_kg", label: "Meilleur €/kg",  icon: "⚖️", desc: "Au kg" },
                { value: "per_unit",    label: "Meilleur €/u",   icon: "🔢", desc: "À l'unité" },
                { value: "best_per_l",  label: "Meilleur €/L",   icon: "🥛", desc: "Au litre" }
              ].each do |s| %>
                <label class="relative flex cursor-pointer flex-col items-center rounded-xl border border-slate-200 bg-slate-50 px-3 py-3 text-center transition hover:border-indigo-300 hover:bg-indigo-50/50 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50 has-[:checked]:ring-1 has-[:checked]:ring-indigo-500">
                  <%= f.radio_button :strategy, s[:value], checked: s[:value] == "cheapest",
                      class: "sr-only",
                      data: { action: "change->strategy#changed" } %>
                  <span class="text-xl"><%= s[:icon] %></span>
                  <span class="mt-1 text-xs font-semibold text-slate-800"><%= s[:label] %></span>
                  <span class="text-[10px] text-slate-500"><%= s[:desc] %></span>
                </label>
              <% end %>
            </div>
          </div>

          <%# ── Submit ── %>
          <div>
            <button type="submit"
                    data-compare-target="submitBtn"
                    class="group relative w-full overflow-hidden rounded-xl bg-indigo-600 px-6 py-3.5 text-base font-bold text-white shadow-md shadow-indigo-200 transition hover:bg-indigo-700 hover:shadow-indigo-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 active:scale-[0.98]">
              <span data-compare-target="btnText" class="flex items-center justify-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                  <path fill-rule="evenodd" d="M8.25 6.75a3.75 3.75 0 117.5 0 3.75 3.75 0 01-7.5 0zM15.75 9.75a3 3 0 116 0 3 3 0 01-6 0zM2.25 9.75a3 3 0 116 0 3 3 0 01-6 0zM6.31 15.117A6.745 6.745 0 0112 12a6.745 6.745 0 016.709 7.498.75.75 0 01-.372.568A12.696 12.696 0 0112 21.75c-2.305 0-4.47-.612-6.337-1.684a.75.75 0 01-.372-.568 6.787 6.787 0 011.019-4.38z" clip-rule="evenodd"/>
                </svg>
                Comparer les prix
              </span>
              <span data-compare-target="btnLoading" class="hidden flex items-center justify-center gap-2">
                <svg class="h-5 w-5 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                </svg>
                Lancement en cours…
              </span>
            </button>
          </div>
        <% end %>
      </div>

      <%# Footer hint %>
      <div class="rounded-b-2xl border-t border-slate-100 bg-slate-50 px-6 py-3">
        <p class="text-center text-xs text-slate-400">
          Les prix sont récupérés en temps réel depuis les sites officiels des enseignes.
        </p>
      </div>
    </div>
  </div>
</section>

<%# ── How it works ── %>
<section class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
  <h2 class="text-center text-2xl font-bold text-slate-900 sm:text-3xl">Comment ça marche ?</h2>
  <div class="mt-10 grid gap-6 sm:grid-cols-3">
    <% [
      { step: "1", icon: "📝", title: "Saisissez votre liste", desc: "Entrez vos produits, un par ligne. PanierBot comprend les noms génériques comme 'pâtes' ou 'lait'." },
      { step: "2", icon: "🔍", title: "Analyse automatique", desc: "Notre agent visite les drives en temps réel et extrait les prix de chaque produit." },
      { step: "3", icon: "🏆", title: "Résultat optimal", desc: "Vous obtenez le panier le moins cher, avec le détail par produit et par enseigne." }
    ].each do |card| %>
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:shadow-md">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-600 text-xl text-white font-bold shadow-md shadow-indigo-200">
          <%= card[:step] %>
        </div>
        <h3 class="mt-4 text-base font-bold text-slate-900"><%= card[:title] %></h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-600"><%= card[:desc] %></p>
      </div>
    <% end %>
  </div>
</section>

<%# ── Stores logos section ── %>
<section class="border-t border-slate-200 bg-white py-10">
  <div class="mx-auto max-w-4xl px-4 sm:px-6">
    <p class="text-center text-xs font-semibold uppercase tracking-widest text-slate-400">Enseignes comparées</p>
    <div class="mt-6 flex flex-wrap items-center justify-center gap-6">
      <% [
        { name: "Leclerc", color: "bg-blue-50 text-blue-700 ring-blue-200" },
        { name: "Carrefour", color: "bg-red-50 text-red-700 ring-red-200" },
        { name: "Intermarché", color: "bg-orange-50 text-orange-700 ring-orange-200" },
        { name: "Super U", color: "bg-emerald-50 text-emerald-700 ring-emerald-200" }
      ].each do |store| %>
        <span class="rounded-full px-4 py-2 text-sm font-bold ring-1 <%= store[:color] %>">
          <%= store[:name] %>
        </span>
      <% end %>
    </div>
  </div>
</section>
