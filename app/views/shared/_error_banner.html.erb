<%# Premium error banner with smooth animations %>
<%# Usage: render "shared/error_banner", message: "Une erreur est survenue." %>
<%# Or:    render "shared/error_banner", errors: ["err1", "err2"] %>
<% message ||= nil %>
<% errors  ||= [] %>
<% all_errors = errors.presence || (message.present? ? [message] : []) %>
<% dismissible ||= true %>

<% if all_errors.any? %>
  <div class="alert alert-error animate-slide-up" role="alert" data-controller="alert" 
       <% if dismissible %>data-action="click->alert#close"<% end %>>
    <div class="flex items-start gap-4">
      <%# Icon -%>
      <div class="flex-shrink-0 mt-1">
        <svg class="h-5 w-5 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4v.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
      
      <%# Content -%>
      <div class="flex-1 min-w-0">
        <% if all_errors.size == 1 %>
          <p class="font-semibold"><%= all_errors.first %></p>
        <% else %>
          <p class="font-semibold mb-2">Des erreurs sont survenues :</p>
          <ul class="space-y-1.5">
            <% all_errors.each do |err| %>
              <li class="text-sm flex items-start gap-2">
                <span class="inline-block h-1.5 w-1.5 rounded-full bg-red-600 mt-1 flex-shrink-0"></span>
                <span><%= err %></span>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
      
      <%# Close button -%>
      <% if dismissible %>
        <button type="button" class="flex-shrink-0 opacity-70 hover:opacity-100 transition-opacity" 
                data-action="click->alert#close" aria-label="Fermer">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      <% end %>
    </div>
  </div>
<% end %>
