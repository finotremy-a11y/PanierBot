<%# Shared error banner component %>
<%# Usage: render "shared/error_banner", message: "Une erreur est survenue." %>
<%# Or:    render "shared/error_banner", errors: ["err1", "err2"] %>
<% message ||= nil %>
<% errors  ||= [] %>
<% all_errors = errors.presence || (message.present? ? [message] : []) %>

<% if all_errors.any? %>
  <div class="rounded-xl border border-red-200 bg-red-50 p-4" role="alert">
    <div class="flex items-start gap-3">
      <div class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-red-100">
        <svg class="h-3 w-3 text-red-600" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-5a.75.75 0 01.75.75v4.5a.75.75 0 01-1.5 0v-4.5A.75.75 0 0110 5zm0 10a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/>
        </svg>
      </div>
      <div class="min-w-0 flex-1">
        <% if all_errors.size == 1 %>
          <p class="text-sm font-medium text-red-800"><%= all_errors.first %></p>
        <% else %>
          <p class="text-sm font-semibold text-red-800">Des erreurs sont survenues :</p>
          <ul class="mt-1 list-inside list-disc space-y-0.5">
            <% all_errors.each do |err| %>
              <li class="text-sm text-red-700"><%= err %></li>
            <% end %>
          </ul>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
