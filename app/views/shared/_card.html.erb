<%# 
  Premium Card Component
  
  Basic usage with block content:
    render "shared/card" do 
      div class="card-header" h3 Title /h3 /div
      div class="card-body" Content here /div
      div class="card-footer" Footer actions /div
    
  Or simple card with premium styling:
    render "shared/card", premium: true do 
      Your content
%>
<% variant = local_assigns[:variant] || (local_assigns[:premium] ? "card-premium" : "card") %>
<% hover_effect = local_assigns[:hover_effect] || false %>
<div class="<%= variant %><% if hover_effect %> hover-lift<% end %>">
  <%= yield %>
</div>
