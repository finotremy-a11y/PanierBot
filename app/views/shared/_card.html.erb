<%#
  Premium Card Component
  Usage:
    <%= render "shared/card" do %>
      <div class="card-header">
        <h3>Title</h3>
      </div>
      <div class="card-body">
        Content here
      </div>
      <div class="card-footer">
        Footer actions
      </div>
    <% end %>
    
    Or simple card:
    <%= render "shared/card", premium: true do %>
      Your content
    <% end %>
%>
<% variant = variant || (premium ? "card-premium" : "card") %>
<div class="<%= variant %> <% if hover_effect %>hover-lift<% end %>">
  <%= yield %>
</div>
