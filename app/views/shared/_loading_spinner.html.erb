<%# Premium loading spinner with smooth animations %>
<%# Usage: render "shared/loading_spinner", message: "Chargement…" %>
<% message ||= "Chargement en cours…" %>
<% help_text ||= nil %>

<div class="flex flex-col items-center justify-center gap-6 py-16">
  <div class="relative h-16 w-16">
    <%# Outer rotating ring -%>
    <div class="absolute inset-0 rounded-full border-4 border-[#bcf0ae]/30"></div>
    <div class="absolute inset-0 animate-spin rounded-full border-4 border-transparent border-t-[#2d5a27] border-r-[#a1d494]" 
         style="animation-duration: 2s"></div>
    
    <%# Inner pulsing dot -%>
    <div class="absolute inset-1/3 rounded-full bg-[#2d5a27] animate-pulse"></div>
  </div>
  
  <div class="text-center space-y-2 max-w-sm">
    <p class="text-base font-semibold text-[#1b1c1c]">
      <%= message %>
    </p>
    <% if help_text.present? %>
      <p class="text-sm text-[#42493e]">
        <%= help_text %>
      </p>
    <% end %>
  </div>
</div>
