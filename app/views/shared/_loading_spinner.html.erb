<%# Premium loading spinner with smooth animations %>
<%# Usage: render "shared/loading_spinner", message: "Chargement…" %>
<% message ||= "Chargement en cours…" %>
<% help_text ||= nil %>

<div class="flex flex-col items-center justify-center gap-6 py-16">
  <div class="relative h-16 w-16">
    <%# Outer rotating ring -%>
    <div class="absolute inset-0 rounded-full border-4 border-indigo-100/30"></div>
    <div class="absolute inset-0 animate-spin rounded-full border-4 border-transparent border-t-indigo-600 border-r-indigo-400" 
         style="animation-duration: 2s"></div>
    
    <%# Inner pulsing dot -%>
    <div class="absolute inset-1/3 rounded-full bg-indigo-600 animate-pulse"></div>
  </div>
  
  <div class="text-center space-y-2 max-w-sm">
    <p class="text-base font-semibold text-slate-900">
      <%= message %>
    </p>
    <% if help_text.present? %>
      <p class="text-sm text-slate-600">
        <%= help_text %>
      </p>
    <% end %>
  </div>
</div>
