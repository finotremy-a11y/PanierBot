<%# Store badge component %>
<%# Usage: render "shared/store_badge", store: "leclerc" %>
<% store ||= "" %>

<% store_config = {
  "leclerc"    => { label: "Leclerc",     classes: "bg-[#ecf9e8] text-[#1b411c] ring-[#a1d494]", dot: "bg-[#2d5a27]" },
  "carrefour"  => { label: "Carrefour",   classes: "bg-[#fce8e8] text-[#9b1c1c] ring-[#f3b5b5]", dot: "bg-[#ba1a1a]" },
  "intermarche"=> { label: "Intermarché", classes: "bg-[#fff3e8] text-[#9a4d00] ring-[#f2c48c]", dot: "bg-[#c27114]" },
  "superu"     => { label: "Super U",     classes: "bg-[#e9f6ec] text-[#23501e] ring-[#b7dbb8]", dot: "bg-[#3b6934]" }
}.freeze %>

<% cfg = store_config[store.to_s.downcase] || { label: store.to_s.capitalize, classes: "bg-[#f6f3f2] text-[#42493e] ring-[#c2c9bb]", dot: "bg-[#72796e]" } %>

<span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold ring-1 <%= cfg[:classes] %>">
  <span class="h-1.5 w-1.5 rounded-full <%= cfg[:dot] %>"></span>
  <%= cfg[:label] %>
</span>
