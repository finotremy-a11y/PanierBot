<!DOCTYPE html>
<html lang="fr">
  <head>
    <title><%= content_for(:title) || "PanierBot — Comparez vos courses" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Comparez les prix de vos courses en drive en quelques secondes.">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="PanierBot">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-slate-50 antialiased">
    <%# ── Navigation ── %>
    <nav class="fixed inset-x-0 top-0 z-50 border-b border-slate-200/80 bg-white/90 backdrop-blur-md">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6">
        <%= link_to root_path, class: "flex items-center gap-2 group" do %>
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-indigo-600 text-white shadow-sm group-hover:bg-indigo-700 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M2.25 2.25a.75.75 0 000 1.5h1.386c.17 0 .318.114.362.278l2.558 9.592a3.752 3.752 0 00-2.806 3.63c0 .414.336.75.75.75h15.75a.75.75 0 000-1.5H5.378A2.25 2.25 0 017.5 15h11.218a.75.75 0 00.674-.421 60.358 60.358 0 002.96-7.228.75.75 0 00-.525-.965A60.864 60.864 0 005.68 4.509l-.232-.867A1.875 1.875 0 003.636 2.25H2.25z"/>
              <path d="M3.75 20.25a1.5 1.5 0 113 0 1.5 1.5 0 01-3 0zM16.5 20.25a1.5 1.5 0 113 0 1.5 1.5 0 01-3 0z"/>
            </svg>
          </span>
          <span class="text-lg font-bold text-slate-900">Panier<span class="text-indigo-600">Bot</span></span>
        <% end %>

        <div class="flex items-center gap-3">
          <%= link_to "Comparer", root_path,
              class: "hidden sm:inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-100 transition-colors" %>
          <%= link_to "Nouvelle comparaison", root_path,
              class: "inline-flex items-center rounded-lg bg-indigo-600 px-3 py-1.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700 transition-colors" %>
        </div>
      </div>
    </nav>

    <%# ── Flash messages ── %>
    <% if flash[:alert].present? %>
      <div class="fixed inset-x-0 top-16 z-40 mx-auto max-w-2xl px-4 pt-3">
        <%= render "shared/error_banner", message: flash[:alert] %>
      </div>
    <% end %>

    <%# ── Main content ── %>
    <main class="pt-16">
      <%= yield %>
    </main>

    <%# ── Footer ── %>
    <footer class="mt-20 border-t border-slate-200 bg-white py-8">
      <div class="mx-auto max-w-6xl px-4 text-center text-sm text-slate-500 sm:px-6">
        <p>PanierBot &mdash; Comparez les prix en drive en quelques secondes.</p>
        <p class="mt-1 text-xs text-slate-400">Leclerc · Carrefour · Intermarché · Super U</p>
      </div>
    </footer>
  </body>
</html>
