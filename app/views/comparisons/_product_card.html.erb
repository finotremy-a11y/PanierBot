<%# Product card partial for comparison results %>
<%# Usage: render "comparisons/product_card", item: item_hash %>
<%
  item            = item || {}
  query           = item[:query] || item["query"] || ""
  winner_store    = item[:winner_store] || item["winner_store"] || ""
  winner_product  = item[:winner_product] || item["winner_product"] || {}
  wp              = winner_product.is_a?(Hash) ? winner_product.transform_keys(&:to_sym) : {}
%>

<div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:shadow-md hover:-translate-y-0.5"
     data-controller="product-details">

  <%# Header %>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0 flex-1">
      <p class="text-xs font-semibold uppercase tracking-wide text-indigo-600">Produit demandé</p>
      <h3 class="mt-0.5 truncate text-base font-bold text-slate-900"><%= query.capitalize %></h3>
    </div>
    <% if winner_store.present? %>
      <%= render "shared/store_badge", store: winner_store %>
    <% end %>
  </div>

  <%# Divider %>
  <div class="my-4 h-px bg-slate-100"></div>

  <%# Winner product info %>
  <% if wp[:name].present? %>
    <p class="truncate text-sm font-medium text-slate-700" title="<%= wp[:name] %>">
      <%= wp[:name] %>
    </p>

    <% if wp[:quantity].present? %>
      <p class="mt-0.5 text-xs text-slate-500"><%= wp[:quantity] %></p>
    <% end %>

    <%# Price row %>
    <div class="mt-3 flex flex-wrap items-end gap-2">
      <% if wp[:price].present? && wp[:price].to_f > 0 %>
        <span class="text-2xl font-extrabold text-slate-900">
          <%= number_to_currency(wp[:price].to_f, unit: "€", separator: ",", delimiter: " ", precision: 2, format: "%n %u") rescue "#{wp[:price]} €" %>
        </span>
      <% end %>

      <% if wp[:price_per_kg].present? && wp[:price_per_kg].to_f > 0 %>
        <span class="rounded-md bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">
          <%= "%.2f" % wp[:price_per_kg].to_f %> €/kg
        </span>
      <% end %>

      <% if wp[:price_per_l].present? && wp[:price_per_l].to_f > 0 %>
        <span class="rounded-md bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">
          <%= "%.2f" % wp[:price_per_l].to_f %> €/L
        </span>
      <% end %>

      <% if wp[:price_per_unit].present? && wp[:price_per_unit].to_f > 0 %>
        <span class="rounded-md bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">
          <%= "%.2f" % wp[:price_per_unit].to_f %> €/u
        </span>
      <% end %>
    </div>

    <%# Details toggle %>
    <button type="button"
            data-action="click->product-details#toggle"
            data-product-details-target="trigger"
            class="mt-4 flex items-center gap-1.5 text-xs font-medium text-indigo-600 hover:text-indigo-800 transition-colors">
      <svg class="h-3.5 w-3.5 transition-transform duration-200" data-product-details-target="icon"
           fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
      </svg>
      Voir détails
    </button>

    <%# Expanded details panel %>
    <div class="overflow-hidden transition-all duration-300" data-product-details-target="panel"
         style="max-height: 0; opacity: 0;">
      <div class="mt-3 rounded-xl bg-slate-50 p-4 text-sm space-y-2">
        <% if wp[:url].present? %>
          <p>
            <span class="font-medium text-slate-600">Lien produit:</span>
            <a href="<%= wp[:url] %>" target="_blank" rel="noopener noreferrer"
               class="ml-1 break-all text-indigo-600 hover:underline">
              Ouvrir <%= winner_store.capitalize %> ↗
            </a>
          </p>
        <% end %>
        <% if winner_store.present? %>
          <p>
            <span class="font-medium text-slate-600">Enseigne gagnante:</span>
            <span class="ml-1"><%= winner_store.capitalize %></span>
          </p>
        <% end %>
      </div>
    </div>
  <% else %>
    <p class="mt-2 rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-700 ring-1 ring-amber-200">
      Produit non trouvé dans les drives.
    </p>
  <% end %>
</div>
