<%# Premium form for shopping list with live validation %>
<% content_for :title, "Créer une liste — PanierBot" %>

<div class="space-y-6 py-10">
  <%# ── Hero section ── %>
  <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
    <div class="inline-block rounded-full bg-[#ecf9e8] px-4 py-2 text-sm font-semibold text-[#2d5a27] ring-1 ring-[#a1d494]">
      ✨ Nouvelle comparaison
    </div>
    <h1 class="mt-4 text-3xl font-extrabold text-[#1b1c1c] sm:text-4xl">
      Comparez vos courses
    </h1>
    <p class="mt-4 text-lg text-[#42493e]">
      Trouvez les meilleurs prix en drive en quelques secondes.
    </p>
  </div>

  <%# ── Form card ── %>
  <form class="card-premium mx-auto max-w-2xl px-4 sm:px-6" method="post" action="<%= carts_path %>">
    <div class="card-body space-y-8">
      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

      <%# ── Store Selection ── %>
      <div class="space-y-3">
        <label for="cart_store" class="label label-required">
          Sélectionnez votre enseigne
        </label>
        <div class="grid gap-3 sm:grid-cols-2">
          <% @stores.each do |store| %>
            <label class="group relative cursor-pointer">
              <input type="radio" name="cart[store]" value="<%= store %>" 
                     class="sr-only peer" required aria-label="<%= store.capitalize %>">
              <div class="rounded-lg border-2 border-[#c2c9bb] bg-white px-4 py-3 transition-all peer-checked:border-[#2d5a27] peer-checked:bg-[#ecf9e8] hover:border-[#a1d494] peer-focus:ring-2 peer-focus:ring-[#2d5a27] peer-focus:ring-offset-2">
                <% case store.downcase %>
                  <% when "leclerc" %>
                    <p class="font-semibold text-[#1b1c1c]">🏪 E.Leclerc</p>
                  <% when "carrefour" %>
                    <p class="font-semibold text-[#1b1c1c]">🛒 Carrefour</p>
                  <% when "intermarche" %>
                    <p class="font-semibold text-[#1b1c1c]">🏬 Intermarché</p>
                  <% when "super_u", "super u" %>
                    <p class="font-semibold text-[#1b1c1c]">🌿 Super U</p>
                <% end %>
                <p class="mt-1 text-xs text-[#72796e]">Comparer les prix</p>
              </div>
            </label>
          <% end %>
        </div>
      </div>

      <%# ── Strategy Selection ── %>
      <div class="space-y-3">
        <label class="label label-required">
          Stratégie de comparaison
        </label>
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="group relative cursor-pointer">
            <input type="radio" name="cart[strategy]" value="cheapest" class="sr-only peer" checked 
                   aria-label="Moins cher">
            <div class="rounded-lg border-2 border-[#c2c9bb] bg-white px-4 py-3 transition-all peer-checked:border-[#2d5a27] peer-checked:bg-[#ecf9e8] hover:border-[#a1d494]">
              <p class="font-semibold text-[#1b1c1c]">💰 Moins cher</p>
              <p class="mt-1 text-xs text-[#72796e]">Prix total minimal</p>
            </div>
          </label>
          <label class="group relative cursor-pointer">
            <input type="radio" name="cart[strategy]" value="best_per_kg" class="sr-only peer"
                   aria-label="Meilleur prix/kg">
            <div class="rounded-lg border-2 border-[#c2c9bb] bg-white px-4 py-3 transition-all peer-checked:border-[#2d5a27] peer-checked:bg-[#ecf9e8] hover:border-[#a1d494]">
              <p class="font-semibold text-[#1b1c1c]">⚖️ Meilleur €/kg</p>
              <p class="mt-1 text-xs text-[#72796e]">Qualité vs prix</p>
            </div>
          </label>
        </div>
      </div>

      <%# ── Shopping List Input ── %>
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <label for="cart_items_text" class="label label-required">
            Votre liste de courses
          </label>
          <span class="text-xs text-[#72796e]">
            <span id="item-count">0</span> articles
          </span>
        </div>
        <textarea name="cart[items_text]" id="cart_items_text"
                  rows="8"
                  placeholder="Un produit par ligne&#10;&#10;Exemples :&#10;Pâtes Barilla&#10;Lait demi-écrémé 1L&#10;Bananes&#10;Œufs (12)&#10;Pain de mie complet"
                  class="input textarea resize-none font-mono text-sm"
                  required aria-label="Liste de courses" 
                  data-controller="list-counter"></textarea>
        <p class="text-xs text-[#72796e]">
          💡 Copiez-collez votre liste d'un appel précédent ou saisissez manuellement.
        </p>
      </div>

      <%# ── CTA Button ── %>
      <button type="submit" class="btn btn-primary btn-lg w-full justify-center">
        <%= render "shared/icon", name: "arrow-right", size: "sm" %>
        Comparer mes prix
      </button>

      <p class="text-center text-xs text-[#72796e]">
        Temps estimé : <strong>2-3 minutes</strong> • Résultats en direct
      </p>
    </div>
  </form>

  <%# ── Info cards ── %>
  <div class="mx-auto max-w-2xl px-4 grid gap-4 sm:grid-cols-3 sm:px-6">
    <div class="rounded-xl border border-[#c2c9bb] bg-white p-4 text-center">
      <p class="text-2xl">⚡</p>
      <p class="mt-2 text-sm font-semibold text-[#1b1c1c]">Ultra rapide</p>
      <p class="mt-1 text-xs text-[#42493e]">Résultats en 2-3 minutes</p>
    </div>
    <div class="rounded-xl border border-[#c2c9bb] bg-white p-4 text-center">
      <p class="text-2xl">🏪</p>
      <p class="mt-2 text-sm font-semibold text-[#1b1c1c]">Multi-enseignes</p>
      <p class="mt-1 text-xs text-[#42493e]">Leclerc, Carrefour, etc.</p>
    </div>
    <div class="rounded-xl border border-[#c2c9bb] bg-white p-4 text-center">
      <p class="text-2xl">💵</p>
      <p class="mt-2 text-sm font-semibold text-[#1b1c1c]">Économisez</p>
      <p class="mt-1 text-xs text-[#42493e]">Jusqu'à 30% d'économies</p>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const textarea = document.getElementById('cart_items_text');
    const counter = document.getElementById('item-count');
    
    function updateCount() {
      const items = textarea.value.trim().split('\n').filter(line => line.trim());
      counter.textContent = items.length;
    }
    
    textarea.addEventListener('input', updateCount);
    updateCount();
  });
</script>
