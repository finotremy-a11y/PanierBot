<%#
  Entry form for PanierBot.
  Users choose a store and provide one item per line.
  Future extension: add quantity parsing and per-item options (brand, budget, bio).
%>
<section class="mx-auto w-full max-w-2xl rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
  <h1 class="text-2xl font-bold text-slate-900">PanierBot</h1>
  <p class="mt-2 text-slate-600">
    Choisissez votre enseigne puis collez une liste de courses (une ligne = un produit).
  </p>

  <%= form_with url: carts_path, scope: :cart, method: :post, class: "mt-8 space-y-6" do |f| %>
    <div>
      <%= f.label :store, "Enseigne", class: "mb-2 block text-sm font-medium text-slate-700" %>
      <%= f.select :store,
          @stores.map { |store| [store.capitalize, store] },
          {},
          class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900 focus:border-slate-500 focus:outline-none" %>
    </div>

    <div>
      <%= f.label :strategy, "Stratégie de comparaison", class: "mb-2 block text-sm font-medium text-slate-700" %>
      <%= f.select :strategy,
          [["Moins cher (prix total)", "cheapest"], ["Meilleur prix/kg", "best_per_kg"]],
          { selected: "cheapest" },
          class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900 focus:border-slate-500 focus:outline-none" %>
    </div>

    <div>
      <%= f.label :items_text, "Liste de courses", class: "mb-2 block text-sm font-medium text-slate-700" %>
      <%= f.text_area :items_text,
          rows: 10,
          placeholder: "pates\nlait demi-ecreme\nbananes",
          class: "block w-full rounded-lg border border-slate-300 px-3 py-2 text-slate-900 focus:border-slate-500 focus:outline-none" %>
    </div>

    <%= f.submit "Construire mon panier", class: "inline-flex items-center rounded-lg bg-slate-900 px-5 py-3 font-medium text-white transition hover:bg-slate-700" %>
  <% end %>
</section>