<%#
  Result page for a cart build execution.
  Displays success/failure, cart URL, and debug details.
  If job is still processing, shows loading state with polling.
%>
<section class="mx-auto w-full max-w-2xl rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
  <h1 class="text-2xl font-bold text-slate-900">Resultat PanierBot</h1>

  <!-- Processing state -->
  <div id="processing-container" style="display: <%= @result[:processing] ? 'block' : 'none' %>;">
    <div class="mt-6 rounded-lg border border-slate-300 bg-blue-50 p-6">
      <div class="flex items-center gap-3">
        <div class="h-5 w-5 animate-spin rounded-full border-2 border-slate-300 border-t-blue-600"></div>
        <p class="text-lg font-medium text-blue-900">Panier en cours de construction…</p>
      </div>
      <p class="mt-3 text-sm text-slate-600">
        Cela peut prendre quelques secondes. Ne fermez pas cette page.
      </p>
    </div>
  </div>

  <!-- Results container (hidden while processing) -->
  <div id="results-container" style="display: <%= @result[:processing] ? 'none' : 'block' %>;">
    <p class="mt-2 text-sm text-slate-600">
      Enseigne: <span class="font-medium text-slate-900"><%= @result[:store].presence || "inconnue" %></span>
    </p>

    <% if Array(@result[:items]).any? %>
      <p class="mt-2 text-sm text-slate-600">
        Produits demandes: <span class="font-medium text-slate-900"><%= Array(@result[:items]).join(", ") %></span>
      </p>
    <% end %>

    <% if @result[:success] %>
      <p class="mt-4 text-emerald-700">Panier pret.</p>
      <% if @result[:url].present? %>
        <p class="mt-3">
          <a href="<%= @result[:url] %>" target="_blank" rel="noopener" class="text-slate-900 underline hover:text-slate-600">
            Ouvrir le panier
          </a>
        </p>
      <% end %>
    <% else %>
      <p class="mt-4 text-red-700">La creation du panier a echoue.</p>
      <% Array(@result[:errors]).each do |error| %>
        <p class="mt-2 text-sm text-slate-700">- <%= error %></p>
      <% end %>
    <% end %>

    <% details = @result[:details].is_a?(Hash) ? @result[:details] : {} %>
    <% if details.present? %>
      <div class="mt-6 rounded-lg border border-slate-200 bg-slate-50 p-4">
        <h2 class="text-sm font-semibold text-slate-900">Details execution</h2>

        <% if details[:addedCount].present? || details[:requestedCount].present? %>
          <p class="mt-2 text-sm text-slate-700">
            Ajoutes: <strong><%= details[:addedCount] || 0 %></strong> / <strong><%= details[:requestedCount] || Array(@result[:items]).size %></strong>
          </p>
        <% end %>

        <% not_found = Array(details[:notFoundItems]).presence || Array(details[:remainingItems]) %>
        <% not_found.each do |item| %>
          <p class="mt-1 text-sm text-slate-700">- Non trouve: <%= item %></p>
        <% end %>
      </div>
    <% end %>
  </div>
</section>

<% if @result[:processing] %>
  <script>
    // Poll job status every 2 seconds
    const cartId = '<%= j params[:id] %>';
    const statusUrl = `/carts/${cartId}/status`;
    let pollCount = 0;
    const maxPollCount = 300; // 10 minutes max (300 * 2 seconds)

    function pollJobStatus() {
      fetch(statusUrl)
        .then(response => response.json())
        .then(data => {
          console.log('[Polling]', data);

          if (data.ready) {
            // Job complete - reload page
            console.log('[Polling] Job complete, reloading...');
            window.location.reload();
          } else if (data.processing) {
            // Still processing - continue polling
            pollCount++;
            if (pollCount >= maxPollCount) {
              console.error('[Polling] Timeout after 10 minutes');
              alert('La construction du panier a dépassé le délai imparti. Veuillez réessayer.');
              window.location.href = '/';
            } else {
              setTimeout(pollJobStatus, 2000);
            }
          } else {
            // Unknown state - reload
            console.log('[Polling] Unknown state, reloading...');
            window.location.reload();
          }
        })
        .catch(error => {
          console.error('[Polling] Error:', error);
          // Retry on error
          pollCount++;
          if (pollCount < maxPollCount) {
            setTimeout(pollJobStatus, 3000); // Wait 3 seconds before retry
          }
        });
    }

    // Start polling immediately
    console.log('[Polling] Starting job status polling...');
    pollJobStatus();
  </script>
<% end %>

  <p class="mt-8">
    <%= link_to "Revenir au formulaire", new_cart_path, class: "text-slate-900 underline hover:text-slate-600" %>
  </p>
</section>