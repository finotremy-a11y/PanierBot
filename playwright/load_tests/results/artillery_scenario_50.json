{
  "config": {
    "target": "http://localhost:3000",
    "phases": [
      {
        "duration": 20,
        "arrivalRate": 5,
        "rampTo": 30,
        "maxVusers": 30,
        "name": "steady-50-users"
      }
    ],
    "http": {
      "timeout": 30,
      "headers": {
        "X-API-Key": "test-api-key",
        "Content-Type": "application/json"
      }
    }
  },
  "scenarios": [
    {
      "name": "Health and stores",
      "weight": 5,
      "flow": [
        {
          "get": {
            "url": "/api/v1/health",
            "headers": {
              "X-API-Key": "test-api-key",
              "Content-Type": "application/json"
            }
          }
        },
        {
          "get": {
            "url": "/api/v1/stores",
            "headers": {
              "X-API-Key": "test-api-key",
              "Content-Type": "application/json"
            }
          }
        }
      ]
    }
  ]
}