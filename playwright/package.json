{
  "name": "panierbot-playwright",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Playwright scripts for PanierBot",
  "scripts": {
    "build-cart": "node build_cart.js",
    "monitor-selectors": "node selector_monitor.js --mode diagnostic",
    "test-navigator": "node test_navigator_agent.js",
    "test-product-flow": "node test_product_flow.js",
    "test-carrefour-flow": "node test_carrefour_flow.js",
    "test-intermarche-flow": "node test_intermarche_flow.js",
    "test-leclerc-single": "node test_leclerc_single.js",
    "test-carrefour-single": "node test_carrefour_single.js",
    "test-intermarche-single": "node test_intermarche_single.js",
    "test-superu-single": "node test_superu_single.js",
    "test-all-stores-full": "node test_all_stores_full.js",
    "test-audit-multistore": "node test_audit_multistore.js",
    "test-full-system": "node test_full_system.js",
    "test-final-comparator": "node test_final_comparator.js",
    "test-extract-products": "node test_extract_products.js",
    "test-retry": "node test_retry.js",
    "install-browsers": "npx playwright install",
    "install-deps": "npx playwright install-deps",
    "load-test": "node load_tests/run_load_tests.js"
  },
  "dependencies": {
    "minimist": "^1.2.8",
    "playwright": "^1.54.0"
  },
  "devDependencies": {
    "artillery": "^2.0.23"
  }
}
